# ══════════════════════════════════════════════════════════════════════
# Biến môi trường cho ChatMQL backend trên SITE DEV
#
# Chép thành .env trên máy chủ dev. TUYỆT ĐỐI KHÔNG commit file .env thật —
# repo chatmql-traduocvietnam là repo CÔNG KHAI, đẩy lên là lộ toàn bộ khóa.
#
# Nguyên tắc: site dev phải dùng CSDL riêng và khóa riêng. Dùng chung với bản
# thật thì mọi lần test lên đơn, gửi tin, tích điểm đều ghi vào dữ liệu khách
# hàng thật.
# ══════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4520

# ── Địa chỉ công khai của chính backend này ───────────────────────────
# Dùng để dựng URL tuyệt đối cho ảnh gửi trong chat. Sai chỗ này thì ảnh AI
# gửi cho khách sẽ trỏ về localhost và không hiện.
PUBLIC_API_URL=https://chatmql-dev.traduocvietnam.com

# ── CORS ──────────────────────────────────────────────────────────────
# Frontend và API dùng CHUNG một tên miền (nginx proxy /api → cổng 4520) nên
# trình duyệt gọi cùng origin, về lý thuyết không cần CORS. Vẫn khai báo để
# chặn domain lạ gọi vào nếu sau này tách subdomain riêng.
CORS_ORIGIN=https://chatmql-dev.traduocvietnam.com

# ── Cơ sở dữ liệu RIÊNG cho dev ───────────────────────────────────────
DATABASE_URL=postgresql://chatmql_dev:MAT_KHAU@127.0.0.1:5432/bizcrm2_dev
REDIS_URL=redis://127.0.0.1:6379

# ── Khóa ký JWT — SINH MỚI cho dev, không dùng lại khóa của bản thật ──
#   openssl rand -hex 32
JWT_SECRET=

# ── Cầu nối sang CRM ──────────────────────────────────────────────────
# Khóa dịch vụ giữa ChatMQL và CRM. Phải TRÙNG với CHATMQL_SECRET_KEY trong
# .env của CRM backend, và phải là khóa MỚI, khác khóa bản thật.
#   openssl rand -hex 32
# CRM chạy cùng máy chủ, gọi nội bộ nên không cần mở ra ngoài Internet.
CRM_ORDER_API_URL=http://127.0.0.1:8000
CRM_ORDER_API_KEY=

# ── Nhà cung cấp AI ───────────────────────────────────────────────────
# ChatMQL KHÔNG đọc key AI từ .env — key lưu trong bảng ai_configs của từng
# tổ chức, nhập qua màn hình Cấu hình AI sau khi deploy. Nhớ dùng project key
# riêng cho dev để tách hạn mức chi tiêu: test AI trả lời và gửi ảnh tốn
# credit thật (hôm nay hệ thống đã có lần dừng vì hết credit).

# ── Chốt chặn khi test (đặt trong .env của CRM backend, KHÔNG phải file này) ──
# DISABLE_LARK_REPORT=1 → KHÔNG bắn báo cáo doanh số vào bot Lark của công ty.
# Site dev phải luôn để 1, nếu không mỗi lần test lên đơn là cả phòng kinh
# doanh nhận thông báo.
